<Window x:Class="BobMapper.View.ObjectList"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:BobMapper.View" 
        xmlns:vm="clr-namespace:BobMapper.ViewModel" 
        d:DataContext="{d:DesignInstance Type=vm:ObjectListViewModel}"
        mc:Ignorable="d"
        ResizeMode="CanMinimize"
        Title="ObjectList" Height="476" Width="800">
    <Grid Background="{DynamicResource Brush.WindowBackground}">
        <ScrollViewer Margin="34,29,34,89">
            <ListView ItemsSource="{Binding mapObjects}" SelectedIndex="{Binding SelectedId}">
                <ListView.View>
                    <GridView>
                        <GridViewColumn Header="Type" DisplayMemberBinding="{Binding ObjectType}">
                        </GridViewColumn>
                        <GridViewColumn Header="Asset" DisplayMemberBinding="{Binding Texture1}">
                        </GridViewColumn>
                        <GridViewColumn Header="Coordinates" DisplayMemberBinding="{Binding Coordinate1}">
                        </GridViewColumn>
                    </GridView>
                </ListView.View>
            </ListView>
        </ScrollViewer>
        <Button Margin="34,385,562,19" Content="Select" Command="{Binding SelectCommand}"/>
    </Grid>
</Window>
