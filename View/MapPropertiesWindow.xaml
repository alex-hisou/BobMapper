<Window x:Class="BobMapper.View.MapPropertiesWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:BobMapper.View" xmlns:viewmodel="clr-namespace:BobMapper.ViewModel" 
        d:DataContext="{d:DesignInstance Type=viewmodel:MapPropertiesWindowViewModel}"
        mc:Ignorable="d"
        Title="MapPropertiesWindow" Height="559" Width="800">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="23*"/>
            <RowDefinition Height="48*"/>
            <RowDefinition Height="52*"/>
            <RowDefinition Height="22*"/>
            <RowDefinition Height="52*"/>
            <RowDefinition Height="22*"/>
            <RowDefinition Height="52*"/>
            <RowDefinition Height="22*"/>
            <RowDefinition Height="52*"/>
            <RowDefinition Height="43*"/>
            <RowDefinition Height="157*"/>
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="64*"/>
            <ColumnDefinition Width="232*"/>
            <ColumnDefinition Width="397*"/>
            <ColumnDefinition Width="107*"/>
        </Grid.ColumnDefinitions>
        <Label Content="Name" FontSize="20" Margin="0,0,188,51" Grid.Column="1" Grid.RowSpan="2" Grid.Row="1" Grid.ColumnSpan="2"/>
        <TextBox Text="{Binding CurrentMapProperties.Name, UpdateSourceTrigger=PropertyChanged}" Grid.Column="1" Grid.Row="2" Margin="0,0,0,21" Grid.RowSpan="2" Grid.ColumnSpan="2"/>
        <CheckBox Content="Apartment level" IsChecked="{Binding CurrentMapProperties.IsApartment}" Grid.Column="1" Margin="0,1,150,20" Grid.Row="4" Grid.ColumnSpan="2">
            <CheckBox.RenderTransform>
                <ScaleTransform ScaleX="1.5" ScaleY="1.5"/>
            </CheckBox.RenderTransform>
        </CheckBox>
        <CheckBox Content="Night level" IsChecked="{Binding CurrentMapProperties.IsNightTime}" Grid.Column="1" Margin="0,22,150,19" Grid.Row="5" Grid.RowSpan="2" Grid.ColumnSpan="2">
            <CheckBox.RenderTransform>
                <ScaleTransform ScaleX="1.5" ScaleY="1.5"/>
            </CheckBox.RenderTransform>
        </CheckBox>
        <Label Content="Tileset" FontSize="20" Margin="0,0,188,43" Grid.Column="1" Grid.Row="8" Grid.RowSpan="2" Grid.ColumnSpan="2"/>
        <ComboBox ItemsSource="{Binding TilesetEnum}" SelectedItem="{Binding CurrentMapProperties.tileset}" Grid.Column="1" Grid.Row="9"/>
    </Grid>
</Window>
