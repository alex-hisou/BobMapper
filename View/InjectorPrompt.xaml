<Window x:Class="BobMapper.View.InjectorPrompt"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:BobMapper.View"
        mc:Ignorable="d"
        Title="Select level to inject into" Height="172" Width="404">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="24*"/>
            <RowDefinition Height="48*"/>
            <RowDefinition Height="27*"/>
            <RowDefinition Height="47*"/>
            <RowDefinition Height="10*"/>
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="16*"/>
            <ColumnDefinition Width="201*"/>
            <ColumnDefinition Width="26*"/>
            <ColumnDefinition Width="122*"/>
            <ColumnDefinition Width="39*"/>
        </Grid.ColumnDefinitions>
        <ComboBox Name="ChapterComboBox" Grid.Column="1" Grid.Row="1"/>
        <TextBox Name="LevelNumber" PreviewTextInput="TextBox_PreviewTextInput" Grid.Column="3" Grid.Row="1"/>
        <Button Click="Button_Click" Grid.Row="3" Grid.Column="3" Content="Confirm"/>
    </Grid>
</Window>
