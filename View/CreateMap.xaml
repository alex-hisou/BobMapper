<Window x:Class="BobMapper.View.CreateMap"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:BobMapper.View" xmlns:viewmodel="clr-namespace:BobMapper.ViewModel" 
        d:DataContext="{d:DesignInstance Type=viewmodel:CreateMapViewModel}"
        mc:Ignorable="d"
        Title="CreateMap" Height="288" Width="543" ResizeMode="NoResize">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="29*"/>
            <RowDefinition Height="30*"/>
            <RowDefinition Height="44*"/>
            <RowDefinition Height="36*"/>
            <RowDefinition Height="44*"/>
            <RowDefinition Height="18*"/>
            <RowDefinition Height="42*"/>
            <RowDefinition Height="29*"/>
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="60*"/>
            <ColumnDefinition Width="109*"/>
            <ColumnDefinition Width="101*"/>
            <ColumnDefinition Width="81*"/>
            <ColumnDefinition Width="151*"/>
            <ColumnDefinition Width="41*"/>
        </Grid.ColumnDefinitions>
        <Label Content="Width" Grid.Column="1" Grid.Row="1"/>
        <Button Content="Back" Grid.Column="1" Click="Button_Click" Grid.Row="6"/>
        <Button Content="Create" Grid.Column="4" Grid.Row="6" Click="Button_Click_1"/>
        <TextBox Name="WidthBox" Grid.Column="1" 
                 Text="{Binding SizeX, UpdateSourceTrigger=LostFocus}" Grid.Row="2" />
        <Label Content="Height" Grid.Column="1" Grid.Row="3"
               PreviewTextInput="TextBox_PreviewTextInput"/>
        <TextBox Name="HeightBox" Grid.Column="1" 
                 Text="{Binding SizeY, UpdateSourceTrigger=LostFocus}" Grid.Row="4"
                 PreviewTextInput="TextBox_PreviewTextInput"/>
        <ComboBox Name="TilesetCB" Grid.Column="4" Grid.Row="2"
                  ItemsSource="{Binding TilesetEnum}" SelectedValue="{Binding SelectedTileset}"/>
        <Label Content="Tileset" HorizontalAlignment="Left" Grid.Column="4" Grid.Row="1"/>
        <Label Content="Name" Grid.Column="3" Grid.Row="3"/>
        <TextBox Grid.Row="4" Grid.ColumnSpan="2" Grid.Column="3" Text="{Binding Name, UpdateSourceTrigger=PropertyChanged}"/>
    </Grid>
</Window>
