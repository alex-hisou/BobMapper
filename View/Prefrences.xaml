<Window x:Class="BobMapper.View.Prefrences"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:BobMapper.View" xmlns:viewmodel="clr-namespace:BobMapper.ViewModel" 
        xmlns:i="http://schemas.microsoft.com/xaml/behaviors"
        xmlns:services="clr-namespace:BobMapper.Services"
        xmlns:s="clr-namespace:System;assembly=netstandard"
        d:DataContext="{d:DesignInstance Type=viewmodel:PrefrencesViewModel}"
        mc:Ignorable="d"
        
        Title="Prefrences" Height="358" Width="517">

    <Window.Resources>
        <services:EnumBoolConverter x:Key="EnumBoolConverter"/>
    </Window.Resources>
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="37*"/>
            <RowDefinition Height="33*"/>
            <RowDefinition Height="49*"/>
            <RowDefinition Height="12*"/>
            <RowDefinition Height="31*"/>
            <RowDefinition Height="40*"/>
            <RowDefinition Height="69*"/>
            <RowDefinition Height="49*"/>
            <RowDefinition Height="22*"/>
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="50*"/>
            <ColumnDefinition Width="327*"/>
            <ColumnDefinition Width="26*"/>
            <ColumnDefinition Width="83*"/>
            <ColumnDefinition Width="31*"/>
        </Grid.ColumnDefinitions>
        <Label Content="Steam resources.dat file" Grid.Column="1" Margin="0,37,0,0" Grid.RowSpan="2"/>
        <TextBox Text="{Binding SteamPath}" IsReadOnly="True" Grid.Column="1" Grid.Row="2" Margin="0,12,0,0">
            <i:Interaction.Triggers>
                <i:EventTrigger EventName="TextChanged">
                    <i:InvokeCommandAction Command="{Binding SettingChangedCommand}"/>
                </i:EventTrigger>
            </i:Interaction.Triggers>
        </TextBox>
        <Button Content="Change" Grid.Column="3" Grid.Row="2" Command="{Binding ChangeSteamDirCommand}" Margin="0,12,0,0"/>
        <CheckBox Content="Auto-select newly-created objects" IsChecked="{Binding AutoSelect}" Grid.Column="1" Grid.Row="4" Margin="0,4,0,10">
            <i:Interaction.Triggers>
                <i:EventTrigger EventName="Checked">
                    <i:InvokeCommandAction Command="{Binding SettingChangedCommand}"/>
                </i:EventTrigger>
                <i:EventTrigger EventName="Unchecked">
                    <i:InvokeCommandAction Command="{Binding SettingChangedCommand}"/>
                </i:EventTrigger>
            </i:Interaction.Triggers>
        </CheckBox>
        <Button Content="Apply" Grid.Column="3" Grid.Row="7" Command="{Binding ApplyCommand}" IsEnabled="{Binding NewChanges}" Margin="0,6,0,5"/>
        <Label Content="Theme" Grid.Column="1" Margin="0,31,0,0" Grid.Row="4" Grid.RowSpan="2"/>
        <StackPanel Grid.Column="1" Grid.Row="6">
            <RadioButton GroupName="Themes" Content="Classic" IsChecked="{Binding CurrentTheme, Converter={StaticResource EnumBoolConverter}, ConverterParameter=Classic}">
                <i:Interaction.Triggers>
                    <i:EventTrigger EventName="Checked">
                        <i:InvokeCommandAction Command="{Binding SettingChangedCommand}"/>
                    </i:EventTrigger>
                    <i:EventTrigger EventName="Unchecked">
                        <i:InvokeCommandAction Command="{Binding SettingChangedCommand}"/>
                    </i:EventTrigger>
                </i:Interaction.Triggers>
            </RadioButton>
            <RadioButton GroupName="Themes" Content="Dark" IsChecked="{Binding CurrentTheme, Converter={StaticResource EnumBoolConverter}, ConverterParameter=Dark}">
                <i:Interaction.Triggers>
                    <i:EventTrigger EventName="Checked">
                        <i:InvokeCommandAction Command="{Binding SettingChangedCommand}"/>
                    </i:EventTrigger>
                    <i:EventTrigger EventName="Unchecked">
                        <i:InvokeCommandAction Command="{Binding SettingChangedCommand}"/>
                    </i:EventTrigger>
                </i:Interaction.Triggers>
            </RadioButton>
        </StackPanel>
    </Grid>
</Window>
